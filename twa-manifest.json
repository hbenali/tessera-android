{
  "packageId": "ovh.hbenali.tessera",
  "host": "tessera.hbenali.ovh",
  "name": "Tessera",
  "launcherName": "Tessera",
  "display": "standalone",
  "themeColor": "#0f1115",
  "themeColorDark": "#0f1115",
  "navigationColor": "#0f1115",
  "navigationColorDark": "#0f1115",
  "navigationDividerColor": "#0f1115",
  "navigationDividerColorDark": "#0f1115",
  "backgroundColor": "#0f1115",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://tessera.hbenali.ovh/icon-512.png",
  "maskableIconUrl": "https://tessera.hbenali.ovh/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "./android.keystore", "alias": "tessera" },
  "appVersionName": "1.5.0",
  "appVersionCode": 1,
  "shortcuts": [
    { "name": "Search", "shortName": "Search", "url": "/?action=search", "chosenIconUrl": "https://tessera.hbenali.ovh/icon-192.png" },
    { "name": "New message", "shortName": "New", "url": "/?action=new", "chosenIconUrl": "https://tessera.hbenali.ovh/icon-192.png" },
    { "name": "Unread", "shortName": "Unread", "url": "/?view=unread", "chosenIconUrl": "https://tessera.hbenali.ovh/icon-192.png" }
  ],
  "generatorApp": "bubblewrap-cli",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://tessera.hbenali.ovh/",
  "minSdkVersion": 24,
  "orientation": "default",
  "displayOverride": ["standalone"],
  "launchHandlerClientMode": "focus-existing",
  "shareTarget": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [ { "name": "files", "accept": ["image/*","video/*","audio/*","application/pdf","text/*"] } ] }
  }
}
